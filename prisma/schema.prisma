generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ChannelRole {
  ADMIN
  MEMBER
}

enum ChannelType {
  WORKSPACE
  TEAM
  DEPARTMENT
  PROJECT
  PRIVATE
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_DELETION
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum WorkspaceType {
  INDIVIDUAL
  COMPANY
  INSTITUTION
}

enum WorkspaceVisibility {
  PRIVATE
  PUBLIC
}

enum WorkspaceMembershipStatus {
  ACTIVE
  SUSPENDED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum WorkspaceRole {
  OWNER
  PROJECT_MANAGER
  MEMBER
  VIEWER
  COLLABORATOR
}

enum OrganizationRole {
  COMPANY_OWNER
  COMPANY_ADMIN
  COMPANY_PROJECT_MANAGER
  COMPANY_MEMBER
  COMPANY_COLLABORATOR
  COMPANY_VIEWER
  INSTITUTION_OWNER
  INSTITUTION_ADMIN
  INSTITUTION_DEPARTMENT_HEAD
  INSTITUTION_LECTURER_STAFF
  INSTITUTION_STUDENT
  INSTITUTION_COLLABORATOR
  INSTITUTION_VIEWER
}

enum DepartmentMembershipRole {
  HEAD
  MEMBER
}

enum InstitutionType {
  UNIVERSITY
  COLLEGE
  SCHOOL
  RESEARCH_INSTITUTION
  OTHER
}

enum InstitutionGroupRole {
  LEAD
  MEMBER
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

enum TeamRole {
  TEAM_LEAD
  MEMBER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectType {
  GENERAL
  ENGINEERING
  DESIGN
  OPERATIONS
  MARKETING
  HR
}

enum ProjectVisibility {
  PRIVATE
  DEPARTMENT_TEAM
  WORKSPACE
}

enum ProjectCommentPolicy {
  ASSIGNEES_ONLY
  TEAM_MEMBERS
  ALL_VIEWERS
}

enum ProjectRole {
  PROJECT_MANAGER
  MEMBER
  COLLABORATOR
  VIEWER
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  CHANGES_REQUESTED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskAssigneeAcceptanceStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum InvitationType {
  WORKSPACE
  TEAM
  PROJECT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
  DECLINED
}

enum NotificationType {
  MENTION
  TASK_ASSIGNED
  TASK_REASSIGNED
  TASK_SUBMITTED
  TASK_APPROVED
  CHANGES_REQUESTED
  COMMENT_REPLY
  MEMBERSHIP_CHANGED
  MEMBERSHIP_SUSPENDED
  MEMBERSHIP_RESTORED
  INVITATION_ACCEPTED
  JOIN_REQUEST_RECEIVED
  JOIN_REQUEST_APPROVED
  JOIN_REQUEST_REJECTED
  MEETING_INVITE
  MEETING_RESCHEDULED
  MEETING_CANCELLED
  PROJECT_UPDATE
  TASK_BLOCKER_REPORTED
  TASK_BLOCKER_RESOLVED
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_DECLINED
  INTEGRATION_RECONNECT_REQUIRED
  SECURITY_ALERT
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum AuthOneTimeCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum EmailDeliveryStatus {
  QUEUED
  SENDING
  ACCEPTED
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  SUPPRESSED
}

enum EmailSuppressionReason {
  HARD_BOUNCE
  COMPLAINT
  MANUAL
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  NON_RENEWING
  CANCELLED
  ATTENTION
}

enum SubscriptionPlanId {
  PRO
  BUSINESS
}

enum SubscriptionInterval {
  MONTHLY
  ANNUAL
}

enum BillingCheckoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum PrivacyRequestType {
  ACCESS
  CORRECTION
  ERASURE
  REDACTION
}

enum PrivacyRequestStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                       String     @id @default(uuid())
  email                    String     @unique
  passwordHash             String
  name                     String
  status                   UserStatus @default(PENDING_VERIFICATION)
  isPlatformAdmin          Boolean    @default(false)
  emailVerifiedAt          DateTime?
  lastLoginAt              DateTime?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @default(now())
  deletedAt                DateTime?
  deletionRequestedAt      DateTime?
  scheduledDeletionAt      DateTime?
  twoFactorSecretEncrypted String?
  twoFactorEnabled         Boolean    @default(false)
  twoFactorVerifiedAt      DateTime?
  twoFactorSetupExpiresAt  DateTime?

  // Onboarding and AI-access fields
  aiAccessEnabled   Boolean   @default(false)
  aiAccessUpdatedAt DateTime?

  profile                       UserProfile?
  sessions                      Session[]
  externalIdentities            ExternalIdentity[]
  googleOAuthLoginCodes         GoogleOAuthLoginCode[]
  authTokens                    AuthToken[]
  authOneTimeCodes              AuthOneTimeCode[]
  twoFactorRecoveryCodes        TwoFactorRecoveryCode[]
  workspaceMemberships          WorkspaceMembership[]
  teamMemberships               TeamMembership[]
  departmentMemberships         DepartmentMembership[]
  institutionGroupMemberships   InstitutionGroupMembership[]
  projectMemberships            ProjectMembership[]
  createdTasks                  Task[]                        @relation("TaskCreator")
  submittedTasks                Task[]                        @relation("TaskSubmittedBy")
  reviewedTasks                 Task[]                        @relation("TaskReviewedBy")
  tasksToReview                 Task[]                        @relation("TaskReviewer")
  createdTaskDocuments          TaskDocument[]                @relation("TaskDocumentCreator")
  savedTaskDocumentVersions     TaskDocumentVersion[]         @relation("TaskDocumentVersionSaver")
  reportedTaskBlockers          TaskBlocker[]                 @relation("TaskBlockerReporter")
  notifiedTaskBlockers          TaskBlocker[]                 @relation("TaskBlockerNotifyUser")
  resolvedTaskBlockers          TaskBlocker[]                 @relation("TaskBlockerResolver")
  timeEntries                   TaskTimeEntry[]
  assignedTasks                 TaskAssignee[]
  authoredComments              Comment[]
  commentMentions               CommentMention[]
  messageMentions               MessageMention[]
  notifications                 Notification[]
  uploadedFiles                 FileAttachment[]
  attachmentVersionsUploaded    AttachmentVersion[]           @relation("AttachmentVersionUploader")
  attachmentVersionFeedback     AttachmentVersionFeedback[]   @relation("AttachmentVersionFeedbackAuthor")
  checklistsCreated             Checklist[]                   @relation("ChecklistCreator")
  checklistItemsCompleted       ChecklistItem[]              @relation("ChecklistItemCompletedBy")
  checklistItemsSignedOff       ChecklistItem[]              @relation("ChecklistItemSignedOffBy")
  checklistItemFeedback         ChecklistItemFeedback[]       @relation("ChecklistItemFeedbackAuthor")
  auditLogs                     AuditLog[]
  invitedWorkspaces             Invitation[]                  @relation("InvitedBy")
  pendingInvitations            Invitation[]                  @relation("InvitedUser")
  acceptedInvitations           Invitation[]                  @relation("AcceptedBy")
  ownedWorkspaces               Workspace[]                   @relation("WorkspaceOwner")
  ownedProjects                 Project[]                     @relation("ProjectOwner")
  completedProjects             Project[]                     @relation("ProjectCompletedBy")
  archivedProjects              Project[]                     @relation("ProjectArchivedBy")
  ledTeams                      Team[]                        @relation("TeamLead")
  taskAssignments               TaskAssignee[]                @relation("TaskAssigner")
  joinRequests                  JoinRequest[]                 @relation("JoinRequestApplicant")
  reviewedJoinRequests          JoinRequest[]                 @relation("JoinRequestReviewer")
  ledInstitutionGroups          InstitutionGroup[]            @relation("InstitutionGroupLead")
  initiatedOwnershipTransfers   WorkspaceOwnershipTransfer[]  @relation("OwnershipTransferInitiator")
  receivedOwnershipTransfers    WorkspaceOwnershipTransfer[]  @relation("OwnershipTransferRecipient")
  acceptedBillingTransfers      WorkspaceOwnershipTransfer[]  @relation("BillingResponsibilityAcceptor")
  billingOwnedSubscriptions     Subscription[]                @relation("SubscriptionBillingOwner")
  privacyRequests               PrivacyRequest[]              @relation("PrivacyRequestOwner")
  reviewedPrivacyRequests       PrivacyRequest[]              @relation("PrivacyRequestReviewer")
  channelsCreated               Channel[]                     @relation("ChannelCreatedBy")
  channelMemberships            ChannelMembership[]           @relation("ChannelMemberships")
  messagesAuthored              Message[]                     @relation("MessageAuthor")
  messageReactions              MessageReaction[]             @relation("MessageReactions")
  messageReadReceipts           MessageReadReceipt[]          @relation("MessageReadReceipts")
  documentsAuthored             Document[]                    @relation("DocumentAuthor")
  documentRevisions             DocumentRevision[]            @relation("DocumentRevisionAuthor")
  documentComments              DocumentComment[]             @relation("DocumentCommentAuthor")
  calendarEventsCreated         CalendarEvent[]               @relation("EventCreatedBy")
  formsCreated                  Form[]                        @relation("FormCreatedBy")
  formResponses                 FormResponse[]                @relation("FormSubmitter")
  calendarInvitations           EventInvitation[]             @relation("EventInvitations")
  integrations                  Integration[]                 @relation("UserIntegrations")
  automationsCreated            Automation[]                  @relation("AutomationCreatedBy")
  meetingsCreated               Meeting[]                     @relation("MeetingCreatedBy")
  meetingParticipations         MeetingParticipant[]          @relation("MeetingParticipants")
  searchHistory                 SearchHistory[]
  webhookSubscriptions          WebhookSubscription[]         @relation("WebhookSubscriptionCreatedBy")
  integrationConnectionsCreated IntegrationConnection[]       @relation("IntegrationConnectionsCreatedBy")
  taskDevLinksLinked            TaskDevLink[]                 @relation("TaskDevLinksLinked")
  aiConversations               AiConversation[]              @relation("AiConversationOwner")
  aiUsageRecords                AiUsageRecord[]               @relation("AiUsageRecordOwner")
  aiActionProposals             AiActionProposal[]            @relation("AiActionProposalOwner")
  aiActionApprovals             AiActionApproval[]            @relation("AiActionApprovalActor")
  aiWritingSessions             AiWritingSession[]            @relation("AiWritingSessionOwner")
  createdCustomFields           ProjectCustomField[]          @relation("ProjectCustomFieldCreator")
  taskSavedViews                TaskSavedView[]               @relation("TaskSavedViewOwner")
  createdTaskTemplates          TaskTemplate[]                @relation("TaskTemplateCreator")
  createdProjectTemplates       ProjectTemplate[]             @relation("ProjectTemplateCreator")
  importJobsCreated             ImportJob[]                   @relation("ImportJobsCreatedBy")
  createdSsoConfigs             WorkspaceSsoConfig[]          @relation("WorkspaceSsoConfigCreator")
  scimTokens                    ScimToken[]                   @relation("ScimTokenUser")
  resourceFoldersCreated        ResourceFolder[]              @relation("ResourceFoldersCreatedBy")
  resourceFilesUploaded         ResourceFile[]                @relation("ResourceFilesUploadedBy")
  resourceBookmarksCreated      ResourceBookmark[]            @relation("ResourceBookmarksCreatedBy")
  resourceRecentItems           ResourceRecentItem[]          @relation("ResourceRecentItems")
  resourceDashboardPreferences  ResourceDashboardPreference[] @relation("ResourceDashboardPreferences")
  onboardingState               UserOnboardingState?          @relation("UserOnboardingState")
  legalAcceptances              UserLegalAcceptance[]         @relation("UserLegalAcceptance")

  @@index([status])
  @@index([createdAt])
  @@index([status, scheduledDeletionAt])
}

model UserOnboardingState {
  id           String    @id @default(uuid())
  userId       String    @unique
  currentStep  String    @default("WELCOME")
  completedAt  DateTime?
  skippedSteps String[]  @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation("UserOnboardingState", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserLegalAcceptance {
  id           String   @id @default(uuid())
  userId       String
  documentType String
  version      String
  acceptedAt   DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation("UserLegalAcceptance", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, version])
  @@index([userId])
  @@index([userId, documentType])
}

model ExternalIdentity {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerSubjectId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubjectId])
  @@unique([userId, provider])
  @@index([userId])
}

model GoogleOAuthState {
  id         String    @id @default(uuid())
  stateHash  String    @unique
  nonceHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

model GoogleOAuthLoginCode {
  id         String    @id @default(uuid())
  codeHash   String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, consumedAt])
}

model UserProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  bio              String?
  jobTitle         String?
  avatarUrl        String?
  avatarStorageKey String?  @unique
  timeZone         String   @default("UTC")
  locale           String   @default("en")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

enum SessionAuthMethod {
  PASSWORD
  SOCIAL
  SSO
  BREAK_GLASS
}

model Session {
  id                       String            @id @default(uuid())
  userId                   String
  refreshTokenHash         String            @unique
  /// Hash of the previous refresh token, kept for one rotation so that a
  /// replayed (already rotated) token can be detected.
  previousRefreshTokenHash String?           @unique
  authMethod               SessionAuthMethod @default(PASSWORD)
  /// For break-glass sessions, enforce a shorter/limited lifetime.
  authMethodExpiresAt      DateTime?
  userAgent                String?
  ip                       String?
  lastUsedAt               DateTime?
  expiresAt                DateTime
  revokedAt                DateTime?
  revokedReason            String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuthToken {
  id          String           @id @default(uuid())
  userId      String
  purpose     AuthTokenPurpose
  tokenHash   String           @unique
  targetEmail String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model AuthOneTimeCode {
  id         String                 @id @default(uuid())
  userId     String
  purpose    AuthOneTimeCodePurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int                    @default(0)
  lastSentAt DateTime               @default(now())
  consumedAt DateTime?
  createdAt  DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Workspaces, teams, and membership
// ---------------------------------------------------------------------------

model Workspace {
  id                  String              @id @default(uuid())
  name                String
  slug                String              @unique
  description         String?
  type                WorkspaceType       @default(COMPANY)
  isPersonal          Boolean             @default(false)
  visibility          WorkspaceVisibility @default(PRIVATE)
  status              WorkspaceStatus     @default(ACTIVE)
  deletionSuspendedAt DateTime?
  timeTrackingEnabled Boolean             @default(false)
  ownerId             String
  /// SHA-256 digest of the join code. The plaintext code is only returned
  /// when an administrator generates or rotates it.
  joinCodeHash        String?             @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?

  owner                  User                         @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members                WorkspaceMembership[]
  teams                  Team[]
  projects               Project[]
  departments            Department[]
  channels               Channel[]
  companyProfile         CompanyProfile?
  institutionProfile     InstitutionProfile?
  institutionGroups      InstitutionGroup[]
  invitations            Invitation[]
  joinRequests           JoinRequest[]
  files                  FileAttachment[]
  checklists             Checklist[]
  documents              Document[]
  calendarEvents         CalendarEvent[]
  forms                  Form[]
  integrations           Integration[]                @relation("WorkspaceIntegrations")
  integrationConnections IntegrationConnection[]      @relation("WorkspaceIntegrationConnections")
  integrationEventLinks  IntegrationEventLink[]
  automations            Automation[]                 @relation("WorkspaceAutomations")
  meetings               Meeting[]
  auditLogs              AuditLog[]
  subscription           Subscription?
  billingPayments        BillingPayment[]
  billingCheckouts       BillingCheckout[]
  billingSeatSync        BillingSeatSync?
  billingCancellation    BillingCancellation?
  ownershipTransfers     WorkspaceOwnershipTransfer[]
  searchHistory          SearchHistory[]
  webhookSubscriptions   WebhookSubscription[]
  aiConversations        AiConversation[]
  aiUsageRecords         AiUsageRecord[]
  aiActionProposals      AiActionProposal[]
  aiWritingSessions      AiWritingSession[]
  taskTemplates          TaskTemplate[]
  projectTemplates       ProjectTemplate[]
  importJobs             ImportJob[]                  @relation("WorkspaceImportJobs")
  importExternalIds      ImportExternalId[]           @relation("WorkspaceImportExternalIds")
  resourceFolders        ResourceFolder[]             @relation("WorkspaceResourceFolders")
  resourceFiles          ResourceFile[]               @relation("WorkspaceResourceFiles")
  resourceBookmarks      ResourceBookmark[]           @relation("WorkspaceResourceBookmarks")

  ssoConfigs    WorkspaceSsoConfig[]
  ssoDomains    WorkspaceSsoDomain[]
  ssoOidcStates SsoOidcState[]
  ssoSamlStates SsoSamlRequestState[]
  scimTokens    ScimToken[]           @relation("ScimTokenWorkspace")
  scimGroups    ScimGroup[]           @relation("ScimGroupWorkspace")

  @@index([ownerId])
  @@index([status])
  @@index([type])
  @@index([visibility])
}

model WorkspaceOwnershipTransfer {
  id                  String        @id @default(uuid())
  workspaceId         String
  initiatedById       String
  recipientUserId     String
  previousOwnerRole   WorkspaceRole @default(MEMBER)
  status              String        @default("PENDING")
  expiresAt           DateTime?
  acceptedAt          DateTime?
  billingAcceptedAt   DateTime?
  billingAcceptedById String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  initiatedBy       User      @relation("OwnershipTransferInitiator", fields: [initiatedById], references: [id], onDelete: Restrict)
  recipient         User      @relation("OwnershipTransferRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  billingAcceptedBy User?     @relation("BillingResponsibilityAcceptor", fields: [billingAcceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([recipientUserId, status])
  @@index([expiresAt])
}

model Subscription {
  id                            String                @id @default(uuid())
  workspaceId                   String                @unique
  billingOwnerId                String?
  plan                          SubscriptionPlanId
  interval                      SubscriptionInterval
  currency                      String                @default("USD")
  status                        SubscriptionStatus    @default(PENDING)
  billableSeats                 Int
  providerCustomerCode          String?
  providerSubscriptionCode      String?               @unique
  providerManageTokenCiphertext String?
  pendingSubscriptionCode       String?               @unique
  pendingManageTokenCiphertext  String?
  pendingPlan                   SubscriptionPlanId?
  pendingInterval               SubscriptionInterval?
  pendingBillableSeats          Int?
  pendingEffectiveAt            DateTime?
  currentPeriodStart            DateTime?
  currentPeriodEnd              DateTime?
  cancelAtPeriodEnd             Boolean               @default(false)
  cancelledAt                   DateTime?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  billingOwner User?             @relation("SubscriptionBillingOwner", fields: [billingOwnerId], references: [id], onDelete: SetNull)
  payments     BillingPayment[]
  checkouts    BillingCheckout[]

  @@index([status, currentPeriodEnd])
}

model PaystackPlan {
  id               String               @id @default(uuid())
  plan             SubscriptionPlanId
  interval         SubscriptionInterval
  billableSeats    Int
  amountSubunit    Int
  currency         String               @default("USD")
  providerPlanCode String               @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([plan, interval, billableSeats])
}

model BillingCheckout {
  id                            String                @id @default(uuid())
  workspaceId                   String
  subscriptionId                String?
  createdByUserId               String
  reference                     String                @unique
  plan                          SubscriptionPlanId
  interval                      SubscriptionInterval
  billableSeats                 Int
  amountSubunit                 Int
  currency                      String                @default("USD")
  status                        BillingCheckoutStatus @default(PENDING)
  checkoutUrl                   String
  providerCustomerCode          String?
  providerPlanCode              String?
  providerSubscriptionCode      String?
  providerManageTokenCiphertext String?
  providerAuthorizationReusable Boolean?
  verifiedAt                    DateTime?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     BillingPayment[]

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
}

model BillingPayment {
  id                String    @id @default(uuid())
  workspaceId       String
  subscriptionId    String?
  checkoutId        String?
  providerReference String    @unique
  providerEventKey  String?   @unique
  amountSubunit     Int
  currency          String
  status            String
  paidAt            DateTime?
  periodStart       DateTime?
  periodEnd         DateTime?
  createdAt         DateTime  @default(now())

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  checkout     BillingCheckout? @relation(fields: [checkoutId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([subscriptionId, createdAt])
}

model BillingWebhookEvent {
  id          String   @id @default(uuid())
  eventKey    String   @unique
  eventType   String
  processedAt DateTime @default(now())
}

/// Durable request to align a recurring subscription quantity with active seats.
/// Provider operations are performed by the billing worker after membership
/// changes commit, so a transient provider outage cannot roll back removal.
model BillingSeatSync {
  id                            String   @id @default(uuid())
  workspaceId                   String   @unique
  requestedSeats                Int
  generation                    Int      @default(1)
  status                        String   @default("PENDING")
  attempts                      Int      @default(0)
  nextAttemptAt                 DateTime @default(now())
  lastError                     String?
  providerSubscriptionCode      String?
  providerManageTokenCiphertext String?
  previousSubscriptionCode      String?
  previousManageTokenCiphertext String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

/// Durable provider cancellation work created when account deletion stops renewal.
model BillingCancellation {
  id            String   @id @default(uuid())
  workspaceId   String   @unique
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

model WorkspaceMembership {
  id               String                    @id @default(uuid())
  workspaceId      String
  userId           String
  role             WorkspaceRole             @default(MEMBER)
  organizationRole OrganizationRole?
  status           WorkspaceMembershipStatus @default(ACTIVE)
  joinedAt         DateTime                  @default(now())
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  workspace               Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationPreferences NotificationPreference[]

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@index([workspaceId, organizationRole])
  @@index([workspaceId, status])
}

model NotificationPreference {
  id           String           @id @default(uuid())
  workspaceId  String
  userId       String
  type         NotificationType
  inAppEnabled Boolean          @default(true)
  emailEnabled Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  membership WorkspaceMembership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@unique([workspaceId, userId, type])
  @@index([userId, workspaceId])
}

model Department {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   DepartmentMembership[]
  teams     Team[]
  projects  Project[]
  channels  Channel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model DepartmentMembership {
  id           String                   @id @default(uuid())
  departmentId String
  userId       String
  role         DepartmentMembershipRole @default(MEMBER)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
}

model CompanyProfile {
  id                 String   @id @default(uuid())
  workspaceId        String   @unique
  name               String
  logoReference      String?
  description        String?
  industryCategory   String?
  officialWebsite    String?
  businessEmail      String?
  contactInformation Json?
  country            String?
  location           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model InstitutionProfile {
  id                 String           @id @default(uuid())
  workspaceId        String           @unique
  name               String
  logoReference      String?
  description        String?
  institutionType    InstitutionType?
  officialWebsite    String?
  institutionalEmail String?
  contactInformation Json?
  country            String?
  location           String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model InstitutionGroup {
  id          String                       @id @default(uuid())
  workspaceId String
  name        String
  description String?
  leadId      String?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  deletedAt   DateTime?
  workspace   Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        User?                        @relation("InstitutionGroupLead", fields: [leadId], references: [id], onDelete: SetNull)
  members     InstitutionGroupMembership[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([leadId])
}

model InstitutionGroupMembership {
  id        String               @id @default(uuid())
  groupId   String
  userId    String
  role      InstitutionGroupRole @default(MEMBER)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  group InstitutionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Team {
  id               String     @id @default(uuid())
  workspaceId      String
  departmentId     String?
  name             String
  description      String?
  responsibilities String?
  leadId           String?
  status           TeamStatus @default(ACTIVE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  lead         User?            @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members      TeamMembership[]
  invitations  Invitation[]
  projects     Project[]
  projectTeams ProjectTeam[]
  channels     Channel[]
  joinRequests JoinRequest[]

  scimGroups ScimGroup[] @relation("ScimGroupTeam")

  @@index([workspaceId])
  @@index([departmentId])
  @@index([leadId])
  @@index([workspaceId, status])
}

model TeamMembership {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Projects and tasks
// ---------------------------------------------------------------------------

model Project {
  id            String               @id @default(uuid())
  workspaceId   String
  teamId        String?
  departmentId  String?
  name          String
  key           String
  description   String?
  objectives    Json?
  category      String?
  labels        String[]             @default([])
  status        ProjectStatus        @default(PLANNING)
  type          ProjectType          @default(GENERAL)
  visibility    ProjectVisibility    @default(WORKSPACE)
  commentPolicy ProjectCommentPolicy @default(ASSIGNEES_ONLY)
  startDate     DateTime?
  dueDate       DateTime?
  ownerId       String
  completedAt   DateTime?
  completedById String?
  archivedAt    DateTime?
  archivedById  String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @default(now())
  deletedAt     DateTime?

  workspace                    Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team                         Team?                         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  department                   Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  owner                        User                          @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  completedBy                  User?                         @relation("ProjectCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  archivedBy                   User?                         @relation("ProjectArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  members                      ProjectMembership[]
  projectTeams                 ProjectTeam[]
  milestones                   ProjectMilestone[]
  tasks                        Task[]
  channels                     Channel[]
  attachments                  FileAttachment[]
  checklists                   Checklist[]
  documents                    Document[]
  calendarEvents               CalendarEvent[]
  meetings                     Meeting[]
  repositories                 ProjectRepository[]           @relation("ProjectRepositories")
  taskDevLinks                 TaskDevLink[]
  customFields                 ProjectCustomField[]
  savedViews                   TaskSavedView[]
  taskTemplates                TaskTemplate[]
  resourceFolders              ResourceFolder[]              @relation("ProjectResourceFolders")
  resourceFiles                ResourceFile[]                @relation("ProjectResourceFiles")
  resourceBookmarks            ResourceBookmark[]            @relation("ProjectResourceBookmarks")
  resourceRecentItems          ResourceRecentItem[]          @relation("ProjectResourceRecentItems")
  resourceDashboardPreferences ResourceDashboardPreference[] @relation("ProjectResourceDashboardPreferences")

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, type])
  @@index([teamId])
  @@index([departmentId])
  @@index([ownerId])
  @@index([dueDate])
  @@index([completedById])
  @@index([archivedById])
  @@index([completedAt])
  @@index([archivedAt])
}

model ProjectMilestone {
  id          String    @id @default(uuid())
  projectId   String
  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, position])
  @@index([projectId, dueDate])
}

model ProjectTeam {
  id        String   @id @default(uuid())
  projectId String
  teamId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([projectId, teamId])
  @@index([projectId])
  @@index([teamId])
}

model ProjectMembership {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
}

model Task {
  id                   String       @id @default(uuid())
  projectId            String
  milestoneId          String?
  key                  String
  title                String
  description          String?
  status               TaskStatus   @default(ASSIGNED)
  priority             TaskPriority @default(MEDIUM)
  category             String?
  labels               String[]     @default([])
  startDate            DateTime?
  dueDate              DateTime?
  completedAt          DateTime?
  position             Int          @default(0)
  parentTaskId         String?
  weight               Int          @default(1)
  creatorId            String
  requiresApproval     Boolean      @default(false)
  expectedDeliverables Json?
  submissionSummary    String?
  submittedAt          DateTime?
  submittedById        String?
  reviewFeedback       String?
  reviewedAt           DateTime?
  reviewedById         String?
  reviewerId           String?
  startedAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @default(now())
  archivedAt           DateTime?
  deletedAt            DateTime?
  dueSoonNotifiedAt    DateTime?
  overdueNotifiedAt    DateTime?

  project             Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone           ProjectMilestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parentTask          Task?                  @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks            Task[]                 @relation("TaskHierarchy")
  creator             User                   @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  submittedBy         User?                  @relation("TaskSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy          User?                  @relation("TaskReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewer            User?                  @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  assignees           TaskAssignee[]
  dependencies        TaskDependency[]       @relation("BlockedTask")
  blockers            TaskDependency[]       @relation("BlockingTask")
  reportedBlockers    TaskBlocker[]
  comments            Comment[]
  attachments         FileAttachment[]
  documents           Document[]
  workDocuments       TaskDocument[]
  timeEntries         TaskTimeEntry[]
  devLinks            TaskDevLink[]
  customFieldValues   TaskCustomFieldValue[]
  recurrenceRule      TaskRecurrenceRule?
  recurrenceSourceId  String?
  recurrenceSource    Task?                  @relation("TaskRecurrenceInstances", fields: [recurrenceSourceId], references: [id], onDelete: SetNull)
  recurrenceInstances Task[]                 @relation("TaskRecurrenceInstances")

  @@unique([projectId, key])
  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([projectId, position])
  @@index([parentTaskId])
  @@index([creatorId])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([reviewerId])
  @@index([dueDate])
  @@index([createdAt])
  @@index([completedAt])
  @@index([status, dueDate])
  @@index([recurrenceSourceId])
  @@index([milestoneId])
  @@index([projectId, milestoneId])
}

model TaskDocument {
  id             String    @id @default(uuid())
  taskId         String
  title          String
  createdById    String
  currentVersion Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  task      Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy User                  @relation("TaskDocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions  TaskDocumentVersion[]

  @@index([taskId])
  @@index([taskId, deletedAt])
  @@index([createdById])
}

enum TaskBlockerStatus {
  OPEN
  RESOLVED
}

model TaskBlocker {
  id           String            @id @default(uuid())
  taskId       String
  status       TaskBlockerStatus @default(OPEN)
  description  String
  reportedById String
  notifyUserId String?
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reportedBy User  @relation("TaskBlockerReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  notifyUser User? @relation("TaskBlockerNotifyUser", fields: [notifyUserId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("TaskBlockerResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([taskId, status])
  @@index([reportedById])
  @@index([notifyUserId])
}

model TaskTimeEntry {
  id              String   @id @default(uuid())
  taskId          String
  userId          String
  startedAt       DateTime
  durationMinutes Int
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, userId])
  @@index([userId])
  @@index([startedAt])
}

model TaskDocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  version    Int
  content    Json
  savedById  String
  createdAt  DateTime @default(now())

  document TaskDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  savedBy  User         @relation("TaskDocumentVersionSaver", fields: [savedById], references: [id], onDelete: Restrict)

  @@unique([documentId, version])
  @@index([documentId, createdAt])
  @@index([savedById])
}

model TaskAssignee {
  id               String                       @id @default(uuid())
  taskId           String
  userId           String
  assignedBy       String?
  assignedAt       DateTime                     @default(now())
  acceptanceStatus TaskAssigneeAcceptanceStatus @default(PENDING)
  acceptedAt       DateTime?
  declinedAt       DateTime?
  declineReason    String?

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assigner User? @relation("TaskAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([taskId, userId])
  @@index([userId])
  @@index([assignedBy])
}

model TaskDependency {
  id              String   @id @default(uuid())
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  task          Task @relation("BlockedTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("BlockingTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

model Comment {
  id        String    @id @default(uuid())
  taskId    String
  authorId  String
  body      String
  parentId  String?
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent      Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]        @relation("CommentReplies")
  attachments FileAttachment[]
  mentions    CommentMention[]

  @@index([taskId, createdAt])
  @@index([authorId])
  @@index([parentId])
}

model CommentMention {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Channels (Phase 7 access integration only; no messages yet)
// ---------------------------------------------------------------------------

model Channel {
  id           String            @id @default(uuid())
  isDefault    Boolean           @default(false)
  systemKey    String?
  postPolicy   ChannelPostPolicy @default(ALL_MEMBERS)
  workspaceId  String
  type         ChannelType
  name         String
  description  String?
  teamId       String?
  departmentId String?
  projectId    String?
  createdById  String
  archivedAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team         Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  department   Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  project      Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy    User                 @relation("ChannelCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  memberships  ChannelMembership[]
  messages     Message[]
  readReceipts MessageReadReceipt[]

  @@unique([workspaceId, systemKey])
  // A unique channel name per workspace among non-deleted channels cannot be
  // expressed in Prisma. It is added as a partial unique index in the
  // migration SQL (see the Phase 7 channel migration).
  @@index([workspaceId, type])
  @@index([workspaceId, archivedAt])
  @@index([teamId])
  @@index([departmentId])
  @@index([projectId])
  @@index([createdById])
}

model ChannelMembership {
  id        String      @id @default(uuid())
  channelId String
  userId    String
  role      ChannelRole @default(MEMBER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation("ChannelMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Messaging (Phase 10)
// ---------------------------------------------------------------------------

model Message {
  id              String             @id @default(uuid())
  type            MessageContentType @default(TEXT)
  audioMime       String?
  audioDurationMs Int?
  audio           MessageAudio?
  channelId       String
  authorId        String
  body            String
  parentId        String?
  editedAt        DateTime?
  pinnedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  channel      Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author       User                 @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  parent       Message?             @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Message[]            @relation("MessageReplies")
  reactions    MessageReaction[]
  readReceipts MessageReadReceipt[]
  mentions     MessageMention[]

  @@index([channelId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@index([pinnedAt])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("MessageReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model MessageReadReceipt {
  id        String   @id @default(uuid())
  channelId String
  userId    String
  messageId String
  readAt    DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation("MessageReadReceipts", fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Notifications, invitations, files, and audit
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type])
}

model Invitation {
  id               String            @id @default(uuid())
  workspaceId      String
  teamId           String?
  projectId        String?
  email            String
  role             WorkspaceRole     @default(MEMBER)
  organizationRole OrganizationRole?
  type             InvitationType    @default(WORKSPACE)
  tokenHash        String            @unique
  status           InvitationStatus  @default(PENDING)
  invitedById      String
  forUserId        String?
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedById     String?
  revokedAt        DateTime?
  declinedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  /// Set while the invitation is pending and cleared when it leaves that
  /// state. The unique index on this column is what stops a second pending
  /// invitation for the same address, while an accepted, revoked or expired
  /// invitation never blocks a new one. A nullable unique column allows many
  /// rows without a value in PostgreSQL.
  pendingKey String? @unique

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team       Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy  User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  forUser    User?     @relation("InvitedUser", fields: [forUserId], references: [id], onDelete: SetNull)
  acceptedBy User?     @relation("AcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([email])
  @@index([status, expiresAt])
  @@index([invitedById])
  @@index([forUserId])
}

model JoinRequest {
  id               String            @id @default(uuid())
  workspaceId      String
  userId           String
  status           JoinRequestStatus @default(PENDING)
  /// The role the applicant will receive if the request is approved.
  role             WorkspaceRole     @default(MEMBER)
  organizationRole OrganizationRole?
  teamId           String?
  message          String?
  reviewedById     String?
  reviewedAt       DateTime?
  decisionNote     String?
  expiresAt        DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  /// Set while the request is pending and cleared when it leaves that state,
  /// so one applicant cannot hold two live requests for the same workspace
  /// while a settled request never blocks a new one.
  pendingKey String? @unique

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User      @relation("JoinRequestApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?     @relation("JoinRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  team       Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([reviewedById])
  @@index([teamId])
}

model FileAttachment {
  id              String    @id @default(uuid())
  workspaceId     String
  projectId       String?
  taskId          String?
  commentId       String?
  uploadedById    String
  fileName        String
  mimeType        String
  sizeBytes       Int
  storageKey      String    @unique
  /// Best-effort plain text extracted at upload time for search. Supports text
  /// formats, DOCX and PDF content streams; legacy binary and image-only files
  /// are not parsed. Extraction failure never fails the upload.
  extractedText   String?
  textExtractedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment   Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploader  User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  versions  AttachmentVersion[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([taskId])
  @@index([commentId])
  @@index([uploadedById])
  @@index([storageKey])
  @@index([workspaceId, createdAt])
}

// ---------------------------------------------------------------------------
// Attachment versions (BE-3)
// ---------------------------------------------------------------------------

/// A stored version of a FileAttachment. The legacy FileAttachment.storageKey
/// remains the v1 object key; every version owns exactly one object key.
model AttachmentVersion {
  id            String    @id @default(uuid())
  attachmentId  String
  versionNumber Int
  isCurrent     Boolean   @default(false)
  fileName      String
  mimeType      String
  sizeBytes     Int
  storageKey    String    @unique
  changeNote    String?
  extractedText String?
  uploadedById  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  attachment FileAttachment              @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  uploader   User                        @relation("AttachmentVersionUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  feedback   AttachmentVersionFeedback[]

  @@unique([attachmentId, versionNumber])
  @@index([attachmentId, createdAt])
  @@index([uploadedById])
}

/// Review feedback attached to one live attachment version.
model AttachmentVersionFeedback {
  id                  String    @id @default(uuid())
  attachmentVersionId String
  authorId            String
  body                String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  editedAt            DateTime?
  deletedAt           DateTime?

  version AttachmentVersion @relation(fields: [attachmentVersionId], references: [id], onDelete: Cascade)
  author  User              @relation("AttachmentVersionFeedbackAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([attachmentVersionId, createdAt])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Project checklists (BE-4)
// ---------------------------------------------------------------------------

/// A project-scoped checklist. `revision` is the optimistic/approval boundary
/// captured by BE-2 bindings; it advances on every real item write.
model Checklist {
  id          String    @id @default(uuid())
  workspaceId String
  projectId   String
  title       String
  description String?
  revision    Int       @default(1)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ChecklistCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items     ChecklistItem[]

  @@index([workspaceId, projectId])
  @@index([projectId, createdAt, id])
}

/// One dense, server-positioned line in a checklist. State fields are paired
/// with actor/timestamp columns; raw CHECKs in the migration enforce the pairs.
model ChecklistItem {
  id            String    @id @default(uuid())
  checklistId   String
  position      Int
  text          String
  completed     Boolean   @default(false)
  completedById String?
  completedAt   DateTime?
  signedOffById String?
  signedOffAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  checklist   Checklist               @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  completedBy User?                   @relation("ChecklistItemCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  signedOffBy User?                   @relation("ChecklistItemSignedOffBy", fields: [signedOffById], references: [id], onDelete: Restrict)
  feedback    ChecklistItemFeedback[]

  @@index([checklistId, position])
  @@index([checklistId, createdAt, id])
  @@index([checklistId, deletedAt])
}

/// Review feedback on exactly one checklist item (concrete FK, not polymorphic).
model ChecklistItemFeedback {
  id              String    @id @default(uuid())
  checklistItemId String
  authorId        String
  body            String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  editedAt        DateTime?
  deletedAt       DateTime?

  checklistItem ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  author        User          @relation("ChecklistItemFeedbackAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([checklistItemId, createdAt])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Documents (Phase 13)
// ---------------------------------------------------------------------------

model Document {
  id          String    @id @default(uuid())
  workspaceId String
  projectId   String?
  taskId      String?
  title       String
  content     String    @default("")
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  author    User               @relation("DocumentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  revisions DocumentRevision[]
  comments  DocumentComment[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([taskId])
  @@index([authorId])
}

model DocumentRevision {
  id         String   @id @default(uuid())
  documentId String
  content    String
  authorId   String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User     @relation("DocumentRevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([documentId, createdAt])
  @@index([authorId])
}

model DocumentComment {
  id         String    @id @default(uuid())
  documentId String
  authorId   String
  body       String
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User     @relation("DocumentCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([documentId, createdAt])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Calendar and Scheduling (Phase 14)
// ---------------------------------------------------------------------------

enum CalendarEventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum EventInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum EventVisibility {
  PUBLIC
  PRIVATE
}

model CalendarEvent {
  id             String              @id @default(uuid())
  workspaceId    String?
  projectId      String?
  createdById    String
  title          String
  description    String?
  location       String?
  startAt        DateTime
  endAt          DateTime
  allDay         Boolean             @default(false)
  status         CalendarEventStatus @default(CONFIRMED)
  visibility     EventVisibility     @default(PUBLIC)
  recurrenceRule String?
  externalId     String?
  externalSource String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy   User              @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  invitations EventInvitation[]
  meetings    Meeting[]

  @@index([workspaceId, startAt])
  @@index([projectId])
  @@index([createdById])
  @@index([startAt, endAt])
}

model EventInvitation {
  id        String                @id @default(uuid())
  eventId   String
  userId    String
  status    EventInvitationStatus @default(PENDING)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation("EventInvitations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Meetings (Phase 15)
// ---------------------------------------------------------------------------

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum MeetingParticipantStatus {
  INVITED
  JOINED
  LEFT
  DECLINED
}

model Meeting {
  id                String        @id @default(uuid())
  workspaceId       String?
  projectId         String?
  calendarEventId   String?
  createdById       String
  title             String
  description       String?
  transcript        String?
  providerMeetingId String?
  providerHostToken String?
  status            MeetingStatus @default(SCHEDULED)
  scheduledAt       DateTime?
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  workspace     Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  calendarEvent CalendarEvent?       @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  createdBy     User                 @relation("MeetingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  participants  MeetingParticipant[]

  @@index([workspaceId, status])
  @@index([projectId])
  @@index([createdById])
  @@index([status, scheduledAt])
}

model MeetingParticipant {
  id        String                   @id @default(uuid())
  meetingId String
  userId    String
  status    MeetingParticipantStatus @default(INVITED)
  joinedAt  DateTime?
  leftAt    DateTime?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation("MeetingParticipants", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Forms and Surveys (Phase 16)
// ---------------------------------------------------------------------------

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum FormFieldType {
  TEXT
  TEXTAREA
  NUMBER
  EMAIL
  SELECT
  MULTISELECT
  RADIO
  CHECKBOX
  DATE
  RATING
  SCALE
}

model Form {
  id          String     @id @default(uuid())
  workspaceId String
  createdById String
  title       String
  description String?
  status      FormStatus @default(DRAFT)
  isPublic    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User           @relation("FormCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  fields    FormField[]
  responses FormResponse[]

  @@index([workspaceId, status])
  @@index([createdById])
}

model FormField {
  id          String        @id @default(uuid())
  formId      String
  label       String
  type        FormFieldType
  required    Boolean       @default(false)
  options     String[]      @default([])
  placeholder String?
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  form    Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers FormAnswer[]

  @@index([formId, position])
}

model FormResponse {
  id          String   @id @default(uuid())
  formId      String
  submittedBy String
  createdAt   DateTime @default(now())

  form      Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  submitter User         @relation("FormSubmitter", fields: [submittedBy], references: [id], onDelete: Restrict)
  answers   FormAnswer[]

  @@index([formId, createdAt])
  @@index([submittedBy])
}

model FormAnswer {
  id         String @id @default(uuid())
  responseId String
  fieldId    String
  value      String

  response FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  field    FormField    @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([fieldId])
}

// ---------------------------------------------------------------------------
// Integrations Framework (Phase 19)
// ---------------------------------------------------------------------------

enum IntegrationProvider {
  GOOGLE_DRIVE
  ONEDRIVE
  DROPBOX
  GMAIL
  OUTLOOK
  SLACK
  GITHUB
  GITLAB
  GOOGLE_CALENDAR
  OUTLOOK_CALENDAR
}

enum IntegrationStatus {
  ACTIVE
  DISCONNECTED
  ERROR
}

model Integration {
  id                     String              @id @default(uuid())
  userId                 String
  workspaceId            String?
  provider               IntegrationProvider
  status                 IntegrationStatus   @default(ACTIVE)
  enabled                Boolean             @default(true)
  accessTokenCiphertext  String
  refreshTokenCiphertext String?
  tokenExpiresAt         DateTime?
  scopes                 String[]            @default([])
  externalUserId         String?
  externalEmail          String?
  /// Provider/workspace-specific non-secret settings (e.g. Slack channel id).
  config                 Json                @default("{}")
  /// Provider sync cursor/state (e.g. Google Calendar sync token). No secrets.
  syncState              Json                @default("{}")
  lastError              String?
  lastRefreshedAt        DateTime?
  lastSyncedAt           DateTime?
  revokedAt              DateTime?
  /// Set when the provider rejected the stored token (for example Slack
  /// invalid_auth). The integration must be reconnected before it is usable.
  needsReconnect         Boolean             @default(false)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  user       User                   @relation("UserIntegrations", fields: [userId], references: [id], onDelete: Cascade)
  workspace  Workspace?             @relation("WorkspaceIntegrations", fields: [workspaceId], references: [id], onDelete: Cascade)
  syncJobs   IntegrationSyncJob[]
  eventLinks IntegrationEventLink[]

  @@unique([userId, provider, workspaceId])
  @@index([userId, status])
  @@index([workspaceId, provider])
  @@index([enabled, status])
}

enum IntegrationSyncStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum IntegrationSyncJobType {
  SYNC
  INBOUND_WEBHOOK
  OUTBOUND_EVENT
}

model IntegrationSyncJob {
  id            String                 @id @default(uuid())
  integrationId String
  type          IntegrationSyncJobType @default(SYNC)
  /// Idempotency key (e.g. provider event id / sync cursor hash).
  dedupeKey     String?
  payload       Json?
  result        Json?
  status        IntegrationSyncStatus  @default(PENDING)
  attempts      Int                    @default(0)
  maxRetries    Int                    @default(5)
  nextAttemptAt DateTime               @default(now())
  lastError     String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([integrationId, createdAt])
}

/// Maps external provider entities to Nexus entities for idempotent sync/import.
model IntegrationEventLink {
  id            String              @id @default(uuid())
  integrationId String
  provider      IntegrationProvider
  workspaceId   String?
  externalType  String
  externalId    String
  localType     String
  localId       String
  /// Extra non-secret sync metadata (e.g. etag/updated stamp) for echo-loop avoidance.
  metadata      Json                @default("{}")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace   Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalType, externalId])
  @@index([provider, workspaceId, localType, localId])
  @@index([workspaceId, provider])
}

enum ImportSource {
  CLICKUP
  TRELLO
  CSV
}

enum ImportJobStatus {
  PREVIEWED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ImportJobMode {
  DRY_RUN
  EXECUTE
}

model ImportJob {
  id             String          @id @default(uuid())
  workspaceId    String
  createdById    String
  source         ImportSource
  mode           ImportJobMode
  status         ImportJobStatus @default(QUEUED)
  /// Original upload/request payload (non-secret). CSV content may be stored inline or referenced.
  payload        Json            @default("{}")
  /// Dry-run preview or execution report (counts, warnings, created ids, errors).
  report         Json            @default("{}")
  /// Client-supplied idempotency key for execute requests.
  idempotencyKey String?
  attempts       Int             @default(0)
  maxRetries     Int             @default(3)
  lastError      String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  workspace Workspace          @relation("WorkspaceImportJobs", fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User               @relation("ImportJobsCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items     ImportExternalId[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, source, createdAt])
  @@index([status, createdAt])
}

/// Stores external source ids for idempotent re-runs of imports.
model ImportExternalId {
  id           String       @id @default(uuid())
  jobId        String?
  workspaceId  String
  source       ImportSource
  externalType String
  externalId   String
  localType    String
  localId      String
  createdAt    DateTime     @default(now())

  job       ImportJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  workspace Workspace  @relation("WorkspaceImportExternalIds", fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, source, externalType, externalId])
  @@index([jobId])
  @@index([workspaceId, source])
}

// ---------------------------------------------------------------------------
// Dev/source-control integrations (Phase 5)
// ---------------------------------------------------------------------------

enum DevIntegrationProvider {
  GITHUB
  GITLAB
}

enum IntegrationConnectionStatus {
  PENDING
  ACTIVE
  DISCONNECTED
  ERROR
}

model IntegrationConnection {
  id                   String                      @id @default(uuid())
  provider             DevIntegrationProvider
  workspaceId          String
  status               IntegrationConnectionStatus @default(PENDING)
  externalAccountId    String?
  externalAccountLogin String?
  externalAccountName  String?
  encryptedCredentials String
  scopes               String[]                    @default([])
  createdById          String
  lastError            String?
  revokedAt            DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  workspace           Workspace           @relation("WorkspaceIntegrationConnections", fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy           User                @relation("IntegrationConnectionsCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  projectRepositories ProjectRepository[]

  @@unique([workspaceId, provider])
  @@index([workspaceId, status])
  @@index([createdById])
}

model ProjectRepository {
  id             String                 @id @default(uuid())
  projectId      String
  connectionId   String
  provider       DevIntegrationProvider
  externalRepoId String
  fullName       String
  defaultBranch  String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  project      Project               @relation("ProjectRepositories", fields: [projectId], references: [id], onDelete: Cascade)
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  taskDevLinks TaskDevLink[]

  @@unique([projectId, provider, externalRepoId])
  @@unique([connectionId, externalRepoId])
  @@index([projectId])
  @@index([connectionId])
}

enum DevLinkType {
  BRANCH
  PULL_REQUEST
  COMMIT
}

model TaskDevLink {
  id                  String                 @id @default(uuid())
  taskId              String
  projectId           String
  projectRepositoryId String?
  provider            DevIntegrationProvider
  externalType        DevLinkType
  externalId          String
  externalNumber      Int?
  title               String?
  url                 String?
  ref                 String?
  headRef             String?
  baseRef             String?
  state               String?
  repositoryFullName  String?
  linkedById          String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  task              Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectRepository ProjectRepository? @relation(fields: [projectRepositoryId], references: [id], onDelete: SetNull)
  linkedBy          User               @relation("TaskDevLinksLinked", fields: [linkedById], references: [id], onDelete: Restrict)

  @@unique([taskId, provider, externalType, externalId])
  @@index([taskId])
  @@index([projectId])
  @@index([projectRepositoryId])
  @@index([linkedById])
}

model GitHubWebhookDelivery {
  id                 String    @id @default(uuid())
  provider           String    @default("GITHUB")
  deliveryId         String
  event              String
  installationId     String?
  repositoryFullName String?
  status             String    @default("RECEIVED")
  processedAt        DateTime?
  error              String?
  createdAt          DateTime  @default(now())

  @@unique([provider, deliveryId])
  @@index([event])
  @@index([installationId])
  @@index([createdAt])
}

model GitLabWebhookDelivery {
  id                String    @id @default(uuid())
  provider          String    @default("GITLAB")
  deliveryId        String
  event             String
  projectIdExternal String?
  status            String    @default("RECEIVED")
  processedAt       DateTime?
  error             String?
  createdAt         DateTime  @default(now())

  @@unique([provider, deliveryId])
  @@index([event])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Automation (Phase 20)
// ---------------------------------------------------------------------------

enum AutomationTrigger {
  EVENT_TASK_CREATED
  EVENT_TASK_COMPLETED
  EVENT_MEMBER_JOINED
  EVENT_TASK_STATUS_CHANGED
  EVENT_TASK_ASSIGNED
  EVENT_TASK_DUE_DATE_PASSED
  EVENT_FORM_SUBMITTED
  SCHEDULED_DAILY
  SCHEDULED_WEEKLY
}

enum AutomationActionType {
  SEND_NOTIFICATION
  CREATE_TASK
  SEND_WEBHOOK
  SET_FIELD
  ASSIGN
  POST_MESSAGE
  SEND_SLACK_MESSAGE
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model Automation {
  id           String               @id @default(uuid())
  workspaceId  String
  createdById  String
  name         String
  trigger      AutomationTrigger
  condition    Json?
  action       AutomationActionType
  actionConfig Json
  enabled      Boolean              @default(true)
  maxRetries   Int                  @default(3)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?

  workspace Workspace       @relation("WorkspaceAutomations", fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User            @relation("AutomationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  runs      AutomationRun[]

  @@index([workspaceId, enabled])
  @@index([createdById])
}

model AutomationRun {
  id            String              @id @default(uuid())
  automationId  String
  status        AutomationRunStatus @default(PENDING)
  attempts      Int                 @default(0)
  error         String?
  eventKey      String?
  payload       Json?
  nextAttemptAt DateTime            @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  // eventKey makes an event-triggered run idempotent: a replayed event cannot
  // create a second run for the same automation. NULL keys (manual runs) are
  // not constrained by PostgreSQL unique indexes.
  @@unique([automationId, eventKey])
  @@index([automationId, status])
  @@index([automationId, createdAt])
  @@index([status, nextAttemptAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  workspaceId   String?
  actorId       String?
  action        String
  targetType    String
  targetId      String
  metadata      Json?
  ip            String?
  userAgent     String?
  securityEvent Boolean  @default(false)
  createdAt     DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([targetType, targetId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([workspaceId, securityEvent, createdAt])
}

model PrivacyRequest {
  id           String               @id @default(uuid())
  userId       String
  type         PrivacyRequestType
  status       PrivacyRequestStatus @default(SUBMITTED)
  description  String?
  targetType   String?
  targetId     String?
  reviewedById String?
  decisionNote String?
  outcome      String?
  decidedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user     User  @relation("PrivacyRequestOwner", fields: [userId], references: [id], onDelete: Restrict)
  reviewer User? @relation("PrivacyRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([reviewedById])
}

// ---------------------------------------------------------------------------
// Transactional email (Phase 4)
// ---------------------------------------------------------------------------

/// A transactional email that the application asked to send.
///
/// The row is written before the provider is contacted, which makes the
/// outbox the source of truth for "did we try to send this". `idempotencyKey`
/// is unique so a retried request can never enqueue the same email twice.
model EmailDelivery {
  id                String              @id @default(uuid())
  toAddress         String
  fromAddress       String
  template          String
  subject           String
  textBody          String
  htmlBody          String?
  headers           Json?
  metadata          Json?
  status            EmailDeliveryStatus @default(QUEUED)
  provider          String
  providerMessageId String?
  idempotencyKey    String              @unique
  attempts          Int                 @default(0)
  maxAttempts       Int                 @default(5)
  lastError         String?
  lastErrorCode     String?
  nextAttemptAt     DateTime            @default(now())
  acceptedAt        DateTime?
  deliveredAt       DateTime?
  bouncedAt         DateTime?
  complainedAt      DateTime?
  failedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, nextAttemptAt])
  @@index([toAddress])
  @@index([template])
  @@index([providerMessageId])
}

/// Addresses that must not receive further email.
///
/// A hard bounce or a spam complaint adds the address here, so the delivery
/// worker skips it instead of damaging the sending reputation of the domain.
model EmailSuppression {
  id           String                 @id @default(uuid())
  emailAddress String                 @unique
  reason       EmailSuppressionReason
  provider     String?
  detail       String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

/// A provider webhook event that has been received.
///
/// `providerEventId` is unique, so a provider that retries a webhook cannot
/// apply the same status change twice.
model EmailWebhookEvent {
  id              String    @id @default(uuid())
  provider        String
  providerEventId String
  type            String
  payload         Json
  outcome         String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  // The event id is only unique per provider, so the provider is part of the
  // key. A provider change must not reject a new event of the new provider.
  @@unique([provider, providerEventId])
  @@index([provider, type])
  @@index([processedAt])
}

