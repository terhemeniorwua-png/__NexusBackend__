  FAILED
}

enum AiUsageStatus {
  SUCCESS
  FAILURE
}

enum AiActionType {
  CREATE_TASK
  ADD_TASK_COMMENT
  COMPLETE_TASK
  CREATE_DOCUMENT
  SEND_NOTIFICATION
