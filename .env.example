NODE_ENV=development
PORT=4000
APP_NAME=Nexus
APP_VERSION=0.1.0

DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6379

CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=false

# Frontend origin used to build the verification, password reset and email
# change links.
FRONTEND_URL=http://localhost:3000

# Google OpenID Connect. Keep GOOGLE_CLIENT_SECRET on the backend only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Existing case-sensitive deployment key used for Google's backend callback.
redirect_URL=http://localhost:4000/api/v1/auth/google/callback
# Legacy fallback; redirect_URL takes precedence when both are set.
GOOGLE_CALLBACK_URL=

LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
TRUST_PROXY=false

SHUTDOWN_TIMEOUT_MS=10000
DB_HEALTH_TIMEOUT_MS=3000
REDIS_HEALTH_TIMEOUT_MS=3000

# --- Authentication ---------------------------------------------------------
# Replace the secret with a random value of at least 32 characters before
# running anything that is not a local development instance.
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Generate a separate random secret (32+ characters); keep stable to validate active OTPs.
OTP_HMAC_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_SALT_ROUNDS=12
VERIFICATION_TOKEN_TTL_SECONDS=3600
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
EMAIL_CHANGE_TOKEN_TTL_SECONDS=3600

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_PASSWORD_RATE_LIMIT_MAX=5
AUTH_VERIFICATION_RATE_LIMIT_MAX=5

# Required 32-byte base64url key for encrypting TOTP secrets. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Keep this stable; rotate using the documented decrypt/re-encrypt procedure.
TOTP_ENCRYPTION_KEY=replace-this-with-a-generated-43-character-key-value
AVATAR_MAX_FILE_SIZE_BYTES=5242880
AVATAR_MAX_DIMENSION=4096
AVATAR_MAX_PIXELS=16000000
AVATAR_RATE_LIMIT_MAX=5

AUTH_VERIFICATION_LINK_PATH=/verify-email
AUTH_PASSWORD_RESET_LINK_PATH=/reset-password
AUTH_EMAIL_CHANGE_LINK_PATH=/settings/email

# --- Workspaces and invitations ------------------------------------------------
# An invitation is a single use link with a 48 hour deadline, which is long
# enough for a person to notice the mail, and the path points at the frontend
# page that shows the invitation.
WORKSPACE_INVITATION_TTL_SECONDS=172800
WORKSPACE_INVITATION_LINK_PATH=/workspaces/invitations/accept

# Join requests are reviewed by a human, so they stay live for seven days.
WORKSPACE_JOIN_REQUEST_TTL_SECONDS=604800
WORKSPACE_JOIN_LINK_PATH=/workspaces/join

# Frontend route for a task. The assignment notifier replaces :projectId and
# :taskId with the encoded identifiers.
TASK_ASSIGNMENT_LINK_PATH=/projects/:projectId/tasks/:taskId
COMMENT_MENTION_LINK_PATH=/projects/:projectId/tasks/:taskId#comment-:commentId
MEETING_INVITATION_LINK_PATH=/meetings/:meetingId

# Frontend route that accepts a team invitation. The team invitation notifier
# appends the single-use token as the `token` query parameter, exactly like the
# workspace invitation route.
TEAM_INVITATION_LINK_PATH=/teams/invitations/accept

# Frontend route that accepts a project invitation. The project invitation
# notifier appends the single-use token as the `token` query parameter.
PROJECT_INVITATION_LINK_PATH=/projects/invitations/accept

# Frontend route for a comment that mentions a member. The mention notifier
# replaces :projectId, :taskId and :commentId with the encoded identifiers.
COMMENT_MENTION_LINK_PATH=/projects/:projectId/tasks/:taskId#comment-:commentId

# Prefix for the Redis rate limit keys. Use a different value per environment
# when they share a Redis instance.
RATE_LIMIT_NAMESPACE=nexus



# --- Transactional email ------------------------------------------------------
# The transport is provider agnostic. Resend, Brevo and Amazon SES all expose
# an SMTP endpoint, so only the connection details change when the provider
# changes. "console" records delivery metadata without sending, "disabled"
# accepts messages without sending them.
#
# The deployment reads its local environment file from `src/.env` first and
# from `.env` in the working directory second. Values that are already set in
# the process environment always win.
EMAIL_PROVIDER=console
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_TLS_REJECT_UNAUTHORIZED=true

# The sender identity. The domain of EMAIL_FROM_ADDRESS needs SPF, DKIM and
# DMARC records before a production deployment sends real mail, and the
# address itself has to be an authorised sender in the provider account.
EMAIL_FROM_ADDRESS=no-reply@nexus.local
EMAIL_FROM_NAME=Nexus
EMAIL_REPLY_TO_ADDRESS=
EMAIL_SUPPORT_ADDRESS=

# Public base URL used for links inside emails. Falls back to FRONTEND_URL.
EMAIL_APP_URL=

# Shared secret used to verify provider webhooks. Leave empty to disable the
# webhook endpoint. Must be at least 32 characters.
EMAIL_WEBHOOK_SECRET=
# Providers that do not sign their events, Brevo among them, are verified
# with this token instead. The webhook URL then ends with the token, so the
# endpoint stays protected by a shared secret. Must be at least 32 characters.
EMAIL_WEBHOOK_TOKEN=
EMAIL_WEBHOOK_SIGNATURE_HEADER=x-nexus-signature
EMAIL_WEBHOOK_TOLERANCE_SECONDS=300

# Delivery policy. A message is attempted at most EMAIL_MAX_ATTEMPTS times,
# including unexpected worker or transport failures; exhausted rows are FAILED.
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_DELAY_MS=30000
EMAIL_RETRY_MAX_DELAY_MS=3600000
EMAIL_REQUEST_TIMEOUT_MS=15000

# The background worker that hands queued messages to the provider.
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_POLL_INTERVAL_MS=5000
EMAIL_WORKER_BATCH_SIZE=10

# --- Paystack billing (Phase 3) ---------------------------------------------
# Hosted checkout is initialized by the backend; no Paystack public key is
# exposed to the browser. Use the test secret key during verification.
PAYSTACK_SECRET_KEY=
# Paystack webhook signing secret (whsec_...) used with Paystack-Signature.
# During rotation, put the previous whsec_... secret in the second variable.
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_WEBHOOK_PREVIOUS_SECRET=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Used only to encrypt the Paystack subscription management token at rest.
PAYSTACK_ENCRYPTION_KEY=
# Set true only after Paystack has approved USD for this merchant account.
PAYSTACK_USD_ENABLED=false
PAYSTACK_CALLBACK_URL=
PAYSTACK_API_URL=https://api.paystack.co
PAYSTACK_REQUEST_TIMEOUT_MS=15000

# Private S3-compatible object storage for organization logos. The bucket must
# block public access; objects are fetched only through authenticated APIs.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REQUEST_TIMEOUT_MS=15000







# Integrations (Slack, etc.)
# AES-256-GCM key for encrypting stored integration tokens.
# Must be 32 random bytes, base64url-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a dedicated key (not the JWT or other secrets). If it is lost or changed,
# every stored integration token becomes unreadable.
INTEGRATION_ENCRYPTION_KEY=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/v1/integrations/slack/callback
