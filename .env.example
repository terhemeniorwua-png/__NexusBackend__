NODE_ENV=development
PORT=4000
APP_NAME=Nexus
APP_VERSION=0.1.0

DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6379

CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=false

# Frontend origin used to build the verification, password reset and email
# change links.
FRONTEND_URL=http://localhost:3000

LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
TRUST_PROXY=false

SHUTDOWN_TIMEOUT_MS=10000
DB_HEALTH_TIMEOUT_MS=3000
REDIS_HEALTH_TIMEOUT_MS=3000

# --- Authentication ---------------------------------------------------------
# Replace the secret with a random value of at least 32 characters before
# running anything that is not a local development instance.
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_SALT_ROUNDS=12
VERIFICATION_TOKEN_TTL_SECONDS=3600
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
EMAIL_CHANGE_TOKEN_TTL_SECONDS=3600

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_PASSWORD_RATE_LIMIT_MAX=5
AUTH_VERIFICATION_RATE_LIMIT_MAX=5

AUTH_VERIFICATION_LINK_PATH=/verify-email
AUTH_PASSWORD_RESET_LINK_PATH=/reset-password
AUTH_EMAIL_CHANGE_LINK_PATH=/settings/email

# --- Workspaces and invitations ------------------------------------------------
# An invitation is a single use link with a deadline. The lifetime is generous
# enough for a person to notice the mail, and the path points at the frontend
# page that shows the invitation.
WORKSPACE_INVITATION_TTL_SECONDS=604800
WORKSPACE_INVITATION_LINK_PATH=/workspaces/invitations/accept

# Prefix for the Redis rate limit keys. Use a different value per environment
# when they share a Redis instance.
RATE_LIMIT_NAMESPACE=nexus

# --- Transactional email ------------------------------------------------------
# The transport is provider agnostic. Resend, Brevo and Amazon SES all expose
# an SMTP endpoint, so only the connection details change when the provider
# changes. "console" records delivery metadata without sending, "disabled"
# accepts messages without sending them.
#
# The deployment reads its local environment file from `src/.env` first and
# from `.env` in the working directory second. Values that are already set in
# the process environment always win.
EMAIL_PROVIDER=console
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_TLS_REJECT_UNAUTHORIZED=true

# The sender identity. The domain of EMAIL_FROM_ADDRESS needs SPF, DKIM and
# DMARC records before a production deployment sends real mail, and the
# address itself has to be an authorised sender in the provider account.
EMAIL_FROM_ADDRESS=no-reply@nexus.local
EMAIL_FROM_NAME=Nexus
EMAIL_REPLY_TO_ADDRESS=
EMAIL_SUPPORT_ADDRESS=

# Public base URL used for links inside emails. Falls back to FRONTEND_URL.
EMAIL_APP_URL=

# Shared secret used to verify provider webhooks. Leave empty to disable the
# webhook endpoint. Must be at least 32 characters.
EMAIL_WEBHOOK_SECRET=
# Providers that do not sign their events, Brevo among them, are verified
# with this token instead. The webhook URL then ends with the token, so the
# endpoint stays protected by a shared secret. Must be at least 32 characters.
EMAIL_WEBHOOK_TOKEN=
EMAIL_WEBHOOK_SIGNATURE_HEADER=x-nexus-signature
EMAIL_WEBHOOK_TOLERANCE_SECONDS=300

# Delivery policy.
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_DELAY_MS=30000
EMAIL_RETRY_MAX_DELAY_MS=3600000
EMAIL_REQUEST_TIMEOUT_MS=15000

# The background worker that hands queued messages to the provider.
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_POLL_INTERVAL_MS=5000
EMAIL_WORKER_BATCH_SIZE=10
